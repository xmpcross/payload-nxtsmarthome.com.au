{
  "name": "nxtsmarthome-com-au",
  "version": "1.0.0",
  "private": true,
  "description": "NXT Smart Home AU — smart home reviews, setup guides and buying advice for Australia",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3022",
    "prebuild": "tsx --env-file=.env.local scripts/build-search-index.mjs && node scripts/gen-redirects.mjs && tsx --env-file=.env.local scripts/fetch-nav.mjs && tsx --env-file=.env.local scripts/fetch-authors.mjs",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 3013",
    "lint": "next lint",
    "audit:content": "tsx --env-file=.env.local scripts/audit-content.mjs",
    "audit:thin": "tsx --env-file=.env.local scripts/audit-thin-content.mjs",
    "deploy": "bash deploy.sh",
    "seed:menu": "node --experimental-strip-types --env-file=.env.local scripts/seed-strapi-menu.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "new:article": "node scripts/new-article.mjs",
    "fetch:products": "node scripts/fetch-top-products.mjs",
    "fetch:products:dry": "node scripts/fetch-top-products.mjs --dry-run",
    "deploy:preview": "bash scripts/deploy-preview.sh",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@hugeicons/core-free-icons": "^1.2.1",
    "@hugeicons/react": "^1.1.10",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "flyonui": "^2.4.1",
    "framer-motion": "^12.43.0",
    "graphql": "^16.8.1",
    "gray-matter": "^4.0.3",
    "lodash": "^4.18.1",
    "lottie-react": "^3.1.2",
    "next": "16.3.6",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-aria": "^3.52.1",
    "react-dom": "19.2.6",
    "react-player": "^2.16.1",
    "react-stately": "^3.50.0",
    "react-swipeable": "^7.0.2",
    "react-use": "^17.6.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "sanitize-html": "^2.18.1",
    "sharp": "0.35.4",
    "tsx": "^4.20.0",
    "unified": "^11.0.5",
    "worker-mailer": "^1.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.16",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3"
  },
  "type": "module"
}
