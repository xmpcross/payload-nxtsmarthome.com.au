# Copy to .env.local and fill in real values there. This file is committed to a
# PUBLIC repository — every sensitive value here must stay blank.

# fal.ai API key for automated cover image generation.
FAL_KEY=

# Geniuslink — TSID from Tools -> Embed Geniuslink in your Website.
# When set, scripts/inject-geniuslink.mjs inserts the Geniuslink script into
# exported pages so supported merchant links can be affiliated automatically.
NEXT_PUBLIC_GENIUSLINK_TSID=
NEXT_PUBLIC_GENIUSLINK_BASE_URL=https://buy.geni.us
NEXT_PUBLIC_GENIUSLINK_PRESERVE_EXISTING=false

# Google AdSense publisher id, e.g. ca-pub-1234567890123456 (AdSense -> Account
# -> Account information). On its own it only verifies the site for review: the
# google-adsense-account meta tag on every page and /ads.txt. No ads display.
# Blank = no meta tag, /ads.txt 404s. See lib/ads.ts.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Set to 1 only AFTER Google approves the site: loads adsbygoogle.js so ads can
# display, and switches the site's advertising wording and consent handling on.
NEXT_PUBLIC_ADSENSE_SHOW_ADS=


# =============================================================================
# API CREDENTIALS — SECRET. Never prefix these with NEXT_PUBLIC_.
# =============================================================================
# Everything above is a tracking ID that already travels in a public outbound
# link, so inlining it into the browser bundle costs nothing. The values below
# are different: they authenticate as you.
#
# This site is a static export. Anything named NEXT_PUBLIC_* is baked into the
# JavaScript that ships to every visitor — a NEXT_PUBLIC_ prefix on a secret
# publishes it. These are read only by build-time scripts running in Node, so
# they must stay unprefixed.

# eBay developer keys (developer.ebay.com → your app → Production keyset).
# Used by the product enrichment script to call the Browse API. The App ID is
# the client id; the Cert ID is the client secret.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Marketplace to search. EBAY_AU for the Australian site.
EBAY_MARKETPLACE=EBAY_AU

# Amazon Product Advertising API 5.0. Access is only granted after three
# qualifying sales in 180 days, so expect these to stay blank for a while.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=

# DataForSEO API credentials for Google Shopping AU (location_code: 2036)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=


# Google Analytics 4 measurement id. Injected into the exported HTML by
# scripts/inject-ga.mjs (postbuild), not rendered by React — see that file.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Local Payload CMS (production: keep automatic schema push disabled)
DATABASE_URL=postgres://nxtsmarthome:<PASSWORD>@127.0.0.1:5435/nxtsmarthome
PAYLOAD_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>
PAYLOAD_DB_PUSH=false
SITE_URL=https://nxtsmarthome.com.au
